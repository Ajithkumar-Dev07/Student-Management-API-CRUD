@model Students

<h1>Student Details</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Student ID: @Model.StudentId</h5>
        <p class="card-text">Name: @Model.StudentName</p>
        <p class="card-text">Course: @Model.Course</p>
        <p class="card-text">Email: @Model.Email</p>
        <p class="card-text">Date of Joining: @Model.DOJ</p>
    </div>

</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-warning">Edit</a>
    <a asp-action="GetAllStudents" class="btn btn-secondary">Back to List</a>
</div>